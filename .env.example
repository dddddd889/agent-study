# 复制为 .env 并填入配置。两种鉴权方式任选其一。

# 方式 A：自建/代理网关（推荐，本机已有这两个环境变量）
ECHO_TECH_ANTHROPIC_BASE_URL=https://your-proxy.example.com
ECHO_TECH_ANTHROPIC_AUTH_TOKEN=your-token

# 方式 B：Anthropic 官方 API
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# 可选：覆盖默认模型
ANTHROPIC_MODEL=claude-sonnet-4-6

# 可选：单次回复输出上限(默认 64000,claude-sonnet-4-6 的上限;换模型可调)
# ANTHROPIC_MAX_TOKENS=64000

# ===== 可选：行为调参(都有默认值,不填即用默认) =====

# 危险工具(shell/读写文件/HTTP)全放行、不再人工确认。⚠ 仅限本地无人值守,慎用。
# AGENT_ALLOW_ALL=1

# 主 agent 干活步数上限(默认 10;辅助工具如 todo 不计入)。大任务可调大。见 docs/14。
# AGENT_MAX_STEPS=10

# 子 agent 独立步数上限(默认 25)。子任务大可调大。见 docs/15。
# AGENT_SUBAGENT_MAX_STEPS=25

# 并行子 agent 的并发上限(默认 5)。一轮派多个时最多几个同时在飞。见 docs/16。
# AGENT_MAX_CONCURRENCY=5

# 上下文压缩软上限(默认 100000)。调小可观察摘要压缩。见 docs/11。
# AGENT_MAX_CONTEXT_TOKENS=100000

# 会话存档目录(默认 .sessions)。
# AGENT_SESSIONS_DIR=.sessions

# MCP 配置文件路径(默认 .mcp.json)。见 docs/13。
# AGENT_MCP_CONFIG=.mcp.json

# 提示词缓存(默认开)。设 0 关闭;见 docs/22。
# AGENT_CACHE=0
# 缓存 TTL:默认 5 分钟,设 1h 切 1 小时(写 2×,适合会话间隔久)。
# AGENT_CACHE_TTL=1h

# 路径沙箱(默认开):文件工具限制在工作目录内。设 0 关闭;见 docs/23。
# AGENT_SANDBOX=0
# 沙箱根(默认当前工作目录)。
# AGENT_SANDBOX_ROOT=/path/to/workspace

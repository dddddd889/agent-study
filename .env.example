# 复制为 .env 并填入配置。两种鉴权方式任选其一。

# 方式 A：自建/代理网关（推荐，本机已有这两个环境变量）
ECHO_TECH_ANTHROPIC_BASE_URL=https://your-proxy.example.com
ECHO_TECH_ANTHROPIC_AUTH_TOKEN=your-token

# 方式 B：Anthropic 官方 API
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# 可选：覆盖默认模型
ANTHROPIC_MODEL=claude-sonnet-4-6

# 可选：单次回复输出上限(默认 64000,claude-sonnet-4-6 的上限;换模型可调)
# ANTHROPIC_MAX_TOKENS=64000

# ===== 可选：行为调参(都有默认值,不填即用默认) =====

# 权限模式(默认 default):会话级审批策略。见 docs/24。
#   default     只读放行,改文件/执行前逐个确认
#   acceptEdits 文件编辑自动放行,shell/网络仍需确认
#   plan        只读探查,任何改文件/执行一律拒绝
#   yolo        一切自动执行、不再确认(⚠ 慎用,取代旧的 AGENT_ALLOW_ALL)
# 运行时可用 /mode 切换。
# AGENT_MODE=default

# 主 agent 干活步数上限(默认 10;辅助工具如 todo 不计入)。大任务可调大。见 docs/14。
# AGENT_MAX_STEPS=10

# 子 agent 独立步数上限(默认 25)。子任务大可调大。见 docs/15。
# AGENT_SUBAGENT_MAX_STEPS=25

# 并行子 agent 的并发上限(默认 5)。一轮派多个时最多几个同时在飞。见 docs/16。
# AGENT_MAX_CONCURRENCY=5

# 上下文压缩软上限(默认 100000)。调小可观察摘要压缩。见 docs/11。
# AGENT_MAX_CONTEXT_TOKENS=100000

# 会话存档目录(默认 .sessions)。
# AGENT_SESSIONS_DIR=.sessions

# MCP 配置文件路径(默认 .mcp.json)。见 docs/13。
# AGENT_MCP_CONFIG=.mcp.json

# 提示词缓存(默认开)。设 0 关闭;见 docs/22。
# AGENT_CACHE=0
# 缓存 TTL:默认 5 分钟,设 1h 切 1 小时(写 2×,适合会话间隔久)。
# AGENT_CACHE_TTL=1h

# 路径沙箱(默认开):文件工具限制在工作目录内。设 0 关闭;见 docs/23。
# AGENT_SANDBOX=0
# 沙箱根(默认当前工作目录)。路径沙箱与执行沙箱【共用】这个根。
# AGENT_SANDBOX_ROOT=/path/to/workspace

# 执行沙箱(默认开):shell 命令关进 OS 级沙箱跑(macOS Seatbelt / Linux bwrap),
# 写限工作目录、禁网;沙箱不可用则 fail-closed 拒跑 shell。见 docs/25。设 0 关闭(shell 裸跑)。
# AGENT_SANDBOX_EXEC=0
# 放开执行沙箱的网络(装依赖等需联网时用;默认禁网)。
# AGENT_SANDBOX_EXEC_NET=1

# http_request 的 SSRF 防护(默认开):发请求前解析目标 IP,拦私有/保留段(内网、云元数据
# 169.254.169.254 等),并逐跳复校重定向。见 docs/26。设 0 关闭(本地连 localhost 自测时用)。
# AGENT_HTTP_SSRF=0
# 可选 HTTP 白名单(防数据外泄):只放行这些 host(含子域),其余含公网一律拒。默认空=不启用。
# AGENT_HTTP_ALLOWLIST=api.github.com,example.com
# http_request 超时(毫秒,默认 30000)。
# AGENT_HTTP_TIMEOUT=30000

# 扩展思考(默认关):让模型答复前先输出推理过程。需支持思考的模型。见 docs/27。
# AGENT_THINKING=1
# 思考预算 token(默认 16000)。须 <max_tokens、≥1024(否则夹到 1024)。
# AGENT_THINKING_BUDGET=16000
# 关掉子 agent 的思考(并行省钱;默认子 agent 继承主 agent 设置)。
# AGENT_SUBAGENT_THINKING=0
